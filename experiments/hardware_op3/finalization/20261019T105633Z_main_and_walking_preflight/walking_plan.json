{
  "model_kind": "qat_int8",
  "model_path": "artifacts/openvino/qat_int8/model.xml",
  "device": "CPU",
  "ros_distro": "jazzy",
  "camera_device": "/dev/video0",
  "camera_resolution": [
    640,
    480
  ],
  "expected_camera_pixel_format": "yuyv",
  "imgsz": 640,
  "batch": 1,
  "confidence_threshold": 0.25,
  "iou_threshold": 0.45,
  "warmup_inferences": 30,
  "warmup_camera_frames": 30,
  "resource_interval_seconds": 0.2,
  "condition": "berjalan",
  "runs": 3,
  "seconds": 60,
  "image_qos_reliability": "best_effort",
  "image_qos_depth": 5,
  "ros_domain_id": 73,
  "operator_confirmation_required": true,
  "execute_now": false,
  "blockers": [
    "Operator physical safety and per-run actual walking confirmation not yet received.",
    "No live manager/motion gateway/fall detector status observed on ROS domains 0 and 73.",
    "Effective stop via the active controller has not been verified by operator.",
    "/dev/video0 is occupied by an existing yuyv2rgb camera process, while the reference camera log records yuyv."
  ],
  "command_template": [
    "bash",
    "scripts/run_op3_qat_measurements.sh",
    "--model-kind",
    "qat_int8",
    "--model",
    "artifacts/openvino/qat_int8/model.xml",
    "--condition",
    "berjalan",
    "--operator-confirmed",
    "--runs",
    "3",
    "--seconds",
    "60",
    "--camera-device",
    "/dev/video0",
    "--image-qos-reliability",
    "best_effort",
    "--image-qos-depth",
    "5",
    "--output",
    "experiments/hardware_op3/operator_runs/<new_timestamp>_qat_berjalan_final/"
  ]
}