<?xml version="1.0"?>
<package format="3">
  <name>yolo11_op3_vision</name>
  <version>0.1.0</version>
  <description>Standalone thesis ROS 2 package for YOLO11 OpenVINO inference on ROBOTIS OP3.</description>
  <maintainer email="rafli5131@users.noreply.github.com">skripsi-yolo11-op3</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>vision_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
